{
  "name": "@congresswiki/handwritten-signature",
  "version": "0.12.15",
  "description": "Animated handwriting component for React using SVG stroke paths",
  "keywords": [
    "react",
    "signature",
    "svg",
    "animation",
    "handwriting",
    "cursive"
  ],
  "homepage": "https://github.com/CongressWiki/handwritten-signature#readme",
  "bugs": {
    "url": "https://github.com/CongressWiki/handwritten-signature/issues"
  },
  "packageManager": "yarn@4.12.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./glyphs": {
      "import": "./dist/glyphs.js",
      "types": "./dist/glyphs.d.ts"
    },
    "./layout": {
      "import": "./dist/layout.js",
      "types": "./dist/layout.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src scripts tsup.config.ts vitest.config.ts vitest.setup.ts eslint.config.mjs",
    "release:publish": "yarn build && npx --yes npm@11.10.0 publish --access public --provenance",
    "site:build": "yarn --cwd site build",
    "site:typecheck": "yarn --cwd site typecheck",
    "test": "vitest",
    "test:run": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CongressWiki/handwritten-signature.git"
  },
  "license": "MIT"
}
